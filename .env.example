# Copy to .env.local and replace every placeholder. Never commit real values.
MONGODB_URI=mongodb+srv://<username>:<url-encoded-password>@<complete-cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=framevault

# Optional Backblaze B2 fallback used while existing media is being migrated.
# Keep these values until /admin/storage reports every referenced file on Hostinger.
B2_KEY_ID=<application-key-id>
B2_APPLICATION_KEY=<application-key-secret>
B2_BUCKET_NAME=<public-media-bucket>
B2_REGION=<region-from-bucket-endpoint>
B2_ENDPOINT=https://s3.<region>.backblazeb2.com
B2_PUBLIC_BASE_URL=https://<bucket>.s3.<region>.backblazeb2.com

# Hostinger persistent media storage. New uploads use this location when set.
# Keep Backblaze active until the media migration and playback checks are complete.
STORAGE_ROOT=/home/<hostinger-user>/domains/<domain>/media-storage

AUTH_SECRET=<at-least-32-random-characters>
APP_URL=http://localhost:3000
# Optional comma-separated additional production or preview origins for Backblaze browser uploads.
CORS_ORIGINS=

# Used only by `npm run seed` to create/update the initial owner.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=<strong-initial-password>
